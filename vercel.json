{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "./build.sh",
  "outputDirectory": "target/release/assets",
  "functions": {
    "api/index.rs": {
      "includeFiles": "target/release/assets/**"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index"
    }
  ]
}
